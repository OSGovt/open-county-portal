# Open County Portal settings: example only.
# The installer writes the real file to /opt/county-portal/.env with generated
# secrets. Every setting is explained in docs/admin/settings.md.
# After changing anything there, run: sudo countyctl restart

# --- Site ---
PORTAL_HOST=portal.example-county.gov
PORTAL_SITE_URL=https://portal.example-county.gov
PORTAL_TLS_MODE=public            # public | internal | provided
PORTAL_ADMIN_EMAIL=it@example-county.gov
PORTAL_ENV=production

# --- Secrets (the installer generates these; never reuse the examples) ---
PORTAL_SECRET_KEY=generate-with-openssl-rand-hex-32
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-24

# --- Outgoing email (docs/admin/email.md) ---
PORTAL_SMTP_HOST=
PORTAL_SMTP_PORT=587
PORTAL_SMTP_USER=
PORTAL_SMTP_PASSWORD=
PORTAL_SMTP_FROM=
PORTAL_SMTP_STARTTLS=true

# --- Backups (docs/admin/backups.md) ---
PORTAL_BACKUP_COPY_CMD=           # e.g. rsync -a {path} backup@nas.example-county.gov:/portal-backups/
PORTAL_BACKUP_KEEP=14

# --- Tuning ---
PORTAL_WORKERS=4
PORTAL_API_RATE=120
PORTAL_API_RATE_KEYED=1200
PORTAL_UPLOAD_MAX_MB=15
PORTAL_ID_RETENTION_DAYS=30
